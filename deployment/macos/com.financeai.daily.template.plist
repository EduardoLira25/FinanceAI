<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>${HOME}</string>
		<key>OLLAMA_HOST</key>
		<string>127.0.0.1:11434</string>
		<key>OLLAMA_NO_CLOUD</key>
		<string>1</string>
		<key>PATH</key>
		<string>${PROJECT_DIR}/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.financeai.daily</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>${PROJECT_DIR}/.venv/bin/python</string>
		<string>-m</string>
		<string>backend.run_scheduled_agent</string>
		<string>--run</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>${PROJECT_DIR}/results/launchd_daily_stderr.log</string>
	<key>StandardOutPath</key>
	<string>${PROJECT_DIR}/results/launchd_daily_stdout.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>18</integer>
		<key>Minute</key>
		<integer>5</integer>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>${PROJECT_DIR}</string>
</dict>
</plist>
